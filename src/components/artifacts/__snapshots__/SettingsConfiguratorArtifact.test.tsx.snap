// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SettingsConfiguratorArtifact > renders the default payload without fetching 1`] = `"<section class="space-y-3 rounded-lg border bg-card p-3 text-card-foreground shadow-sm" data-slot="artifact" data-artifact-type="settings"><header class="flex items-baseline justify-between"><h3 class="font-heading text-sm font-semibold">Settings recommendation</h3><span class="text-xs text-muted-foreground">MIG · mild steel</span></header><div class="grid grid-cols-3 gap-2"><label class="flex flex-col gap-1 text-xs"><span class="text-muted-foreground">Process</span><select class="rounded-md border bg-background px-2 py-1 text-sm" aria-label="Process"><option value="MIG" selected="">MIG</option><option value="TIG">TIG</option><option value="Stick">Stick</option></select></label><label class="flex flex-col gap-1 text-xs"><span class="text-muted-foreground">Material</span><select class="rounded-md border bg-background px-2 py-1 text-sm" aria-label="Material"><option value="mild_steel" selected="">mild steel</option></select></label><label class="flex flex-col gap-1 text-xs"><span class="text-muted-foreground">Thickness (in)</span><input type="number" min="0.01" max="1" step="0.01" class="rounded-md border bg-background px-2 py-1 text-sm" aria-label="Thickness in inches" value="0.125"/></label></div><div class="space-y-3"><div class="space-y-1.5 rounded-md border bg-muted/30 p-2"><div class="flex flex-wrap items-center gap-1.5 text-xs"><span class="rounded bg-primary/10 px-1.5 py-0.5 font-medium text-primary">MIG · solid-core</span><span class="text-muted-foreground">Moderate — some practice</span></div><ul class="ml-3 list-disc space-y-0.5 text-xs"><li>Gas: required, 20–30 SCFH</li><li>Clean — minimal spatter</li><li>Applications: General fabrication; Sheet metal</li></ul></div></div><p class="rounded-md bg-secondary/60 px-2 py-1 text-[0.7rem] text-secondary-foreground">The welder computes A/V on-screen from wire diameter + thickness — see the LCD (p. 20).</p><footer class="flex items-center justify-between text-[0.7rem] text-muted-foreground"><span>p. 1</span></footer></section>"`;
