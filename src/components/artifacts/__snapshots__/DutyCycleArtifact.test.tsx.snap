// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`DutyCycleArtifact > renders the default payload without fetching 1`] = `"<section class="space-y-3 rounded-lg border bg-card p-3 text-card-foreground shadow-sm" data-slot="artifact" data-artifact-type="duty_cycle"><header class="flex items-baseline justify-between"><h3 class="font-heading text-sm font-semibold">Duty cycle</h3><span class="text-xs text-muted-foreground">MIG · 240 V</span></header><div class="grid grid-cols-2 gap-2"><label class="flex flex-col gap-1 text-xs"><span class="text-muted-foreground">Process</span><select class="rounded-md border bg-background px-2 py-1 text-sm" disabled="" aria-label="Process"><option value="MIG" selected="">MIG</option><option value="TIG">TIG</option><option value="Stick">Stick</option></select></label><label class="flex flex-col gap-1 text-xs"><span class="text-muted-foreground">Input voltage</span><select class="rounded-md border bg-background px-2 py-1 text-sm" disabled="" aria-label="Input voltage"><option value="120">120 V</option><option value="240" selected="">240 V</option></select></label></div><label class="block space-y-1 text-xs"><span class="flex items-baseline justify-between"><span class="text-muted-foreground">Amperage</span><span class="font-mono text-sm text-foreground">200 A</span></span><input type="range" min="150" max="250" step="1" disabled="" class="w-full accent-primary" aria-label="Amperage" value="200"/></label><div class="grid grid-cols-3 gap-2 rounded-md bg-muted/40 p-2 text-center text-xs"><div><div class="text-[0.65rem] uppercase tracking-wide text-muted-foreground">Duty cycle</div><div class="font-mono text-sm text-foreground">25%</div></div><div><div class="text-[0.65rem] uppercase tracking-wide text-muted-foreground">Work / 10 min</div><div class="font-mono text-sm text-foreground">2.5 min</div></div><div><div class="text-[0.65rem] uppercase tracking-wide text-muted-foreground">Rest / 10 min</div><div class="font-mono text-sm text-foreground">7.5 min</div></div><div class="col-span-3"><span class="inline-flex rounded-full bg-amber-100 px-2 py-0.5 text-[0.65rem] font-medium text-amber-800 dark:bg-amber-950 dark:text-amber-200">Rated duty cycle — observe work/rest split</span></div></div><footer class="flex items-center justify-between text-[0.7rem] text-muted-foreground"><span>p. 7</span></footer></section>"`;
