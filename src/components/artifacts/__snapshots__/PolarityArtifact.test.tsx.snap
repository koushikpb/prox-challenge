// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`PolarityArtifact > renders the default payload 1`] = `"<section class="space-y-3 rounded-lg border bg-card p-3 text-card-foreground shadow-sm" data-slot="artifact" data-artifact-type="polarity"><header class="flex items-baseline justify-between gap-2"><h3 class="font-heading text-sm font-semibold">Polarity wiring</h3><span class="inline-flex rounded-full px-2 py-0.5 text-[0.7rem] font-semibold bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-200">DCEP</span></header><p class="rounded-md border border-amber-300 bg-amber-50 px-2 py-1 text-[0.7rem] text-amber-900 dark:border-amber-700 dark:bg-amber-950/40 dark:text-amber-100">Unplug the welder before swapping cables between sockets.</p><div role="tablist" aria-label="Process" class="flex flex-wrap gap-1"><button type="button" role="tab" aria-selected="true" class="rounded-full border px-2 py-0.5 text-[0.7rem] font-medium transition-colors border-primary bg-primary text-primary-foreground">MIG (solid-core, gas)</button><button type="button" role="tab" aria-selected="false" class="rounded-full border px-2 py-0.5 text-[0.7rem] font-medium transition-colors border-border bg-background text-muted-foreground hover:text-foreground">MIG (flux-cored)</button><button type="button" role="tab" aria-selected="false" class="rounded-full border px-2 py-0.5 text-[0.7rem] font-medium transition-colors border-border bg-background text-muted-foreground hover:text-foreground">TIG</button><button type="button" role="tab" aria-selected="false" class="rounded-full border px-2 py-0.5 text-[0.7rem] font-medium transition-colors border-border bg-background text-muted-foreground hover:text-foreground">Stick (SMAW)</button></div><svg viewBox="0 0 320 180" role="img" aria-label="Polarity diagram: MIG (solid-core, gas) runs DCEP" class="h-auto w-full"><rect x="80" y="20" width="160" height="140" rx="10" fill="hsl(var(--muted) / 0.3)" stroke="currentColor" stroke-opacity="0.2"></rect><text x="160" y="38" text-anchor="middle" font-size="11" fill="currentColor" opacity="0.6">Front sockets</text><g><circle cx="120" cy="100" r="20" fill="#e2e8f0" stroke="#475569" stroke-width="3" opacity="1"></circle><text x="120" y="104" text-anchor="middle" font-size="14" font-weight="600" fill="#475569">−</text></g><g><circle cx="200" cy="100" r="20" fill="#fee2e2" stroke="#dc2626" stroke-width="3" opacity="1"></circle><text x="200" y="104" text-anchor="middle" font-size="14" font-weight="600" fill="#dc2626">+</text></g><g><path d="M 120 100 C 80 100, 80 150, 40 150" stroke="#0f172a" stroke-width="3" fill="none" stroke-linecap="round"></path><circle cx="40" cy="150" r="4" fill="#0f172a"></circle><text x="40" y="168" text-anchor="middle" font-size="10" fill="currentColor" opacity="0.75">Ground clamp</text></g><g><path d="M 200 100 C 240 100, 240 150, 280 150" stroke="#dc2626" stroke-width="3" fill="none" stroke-linecap="round"></path><circle cx="280" cy="150" r="4" fill="#dc2626"></circle><text x="280" y="168" text-anchor="middle" font-size="10" fill="currentColor" opacity="0.75">Wire-feed cable</text></g></svg><p class="text-xs text-muted-foreground">Gas-shielded solid wire</p><footer class="text-[0.7rem] text-muted-foreground">p. 14</footer></section>"`;
