# ----------------------------------------------------------------------------
# Vulcan OmniPro 220 Assistant — example environment variables.
# Copy this file to `.env` and fill in the values below before running `npm run dev`.
# ----------------------------------------------------------------------------

# Anthropic API key (server-only). Required at runtime for the /api/chat route.
# Obtain one from https://console.anthropic.com/. Never expose this key to the
# browser — it is read only from server-side code (Route Handlers, scripts/).
ANTHROPIC_API_KEY=

# Voice surface feature flag (public). When set to `true`, the chat composer
# enables the microphone (push-to-talk speech-to-text) and speaker (text-to-
# speech for assistant replies) buttons. Both controls rely on the browser's
# Web Speech APIs — Chrome is the most reliable host; Safari and Firefox
# support varies. With the flag unset or `false`, the buttons render disabled
# with an explanatory tooltip.
NEXT_PUBLIC_VOICE_ENABLED=false
